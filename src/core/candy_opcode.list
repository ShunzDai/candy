#ifdef CANDY_OPCODE
#undef CANDY_OPCODE
#endif /* CANDY_OPCODE */

#if defined(CANDY_OPCODE_ENUM)
#undef CANDY_OPCODE_ENUM
#define CANDY_OPCODE(_opcode, ...) OP_##_opcode,
#endif /* CANDY_OPCODE_ENUM */

#if defined(CANDY_OPCODE_CASE)
#undef CANDY_OPCODE_CASE
#define CANDY_OPCODE(_opcode, ...) vmcase(_opcode): { \
  __VA_ARGS__ \
  vmbreak(); \
}
#endif /* CANDY_OPCODE_CASE */

#if defined(CANDY_OPCODE_LABEL)
#undef CANDY_OPCODE_LABEL
#define CANDY_OPCODE(_opcode, ...) &&L_##_opcode,
#endif /* CANDY_OPCODE_LABEL */

#if defined(CANDY_OPCODE_STR)
#undef CANDY_OPCODE_STR
#define CANDY_OPCODE(_opcode, ...) #_opcode,
#endif /* CANDY_OPCODE_STR */

#ifdef CANDY_OPCODE
CANDY_OPCODE(ADD,
  _op_add(it, base, base);
)

CANDY_OPCODE(ADDK,
  _op_add(it, base, constants);
)

CANDY_OPCODE(SUB,
  _op_sub(it, base, base);
)

CANDY_OPCODE(SUBK,
  _op_sub(it, base, constants);
)

CANDY_OPCODE(MUL,
  _op_mul(it, base, base);
)

CANDY_OPCODE(MULK,
  _op_mul(it, base, constants);
)

CANDY_OPCODE(DIV,
  _op_div(it, base, base);
)

CANDY_OPCODE(DIVK,
  _op_div(it, base, constants);
)

CANDY_OPCODE(MOD,
  _op_mod(it, base, base);
)

CANDY_OPCODE(MODK,
  _op_mod(it, base, constants);
)

CANDY_OPCODE(LT,
  _op_lt(it, base, base);
)

CANDY_OPCODE(LTK,
  _op_lt(it, base, constants);
)

CANDY_OPCODE(EQ,
  _op_eq(it, base, base);
)

CANDY_OPCODE(EQK,
  _op_eq(it, base, constants);
)

CANDY_OPCODE(NEQ,
  _op_neq(it, base, base);
)

CANDY_OPCODE(NEQK,
  _op_neq(it, base, constants);
)

CANDY_OPCODE(BOOL,
  _op_bool(it, base);
)

CANDY_OPCODE(NOT,
  _op_not(it, base);
)

CANDY_OPCODE(LE,
  _op_le(it, base, base);
)

CANDY_OPCODE(LEK,
  _op_le(it, base, constants);
)

CANDY_OPCODE(GTK,
  candy_wrap_set_boolean(base + it->iabc.a, _less_than(constants + it->iabc.c, base + it->iabc.b));
)

CANDY_OPCODE(GEK,
  candy_wrap_set_boolean(base + it->iabc.a, _less_equal(constants + it->iabc.c, base + it->iabc.b));
)

CANDY_OPCODE(BAND,
  _bit_op(self, it, base, base + it->iabc.c, _i_band);
)

CANDY_OPCODE(BANDK,
  _bit_op(self, it, base, constants + it->iabc.c, _i_band);
)

CANDY_OPCODE(BOR,
  _bit_op(self, it, base, base + it->iabc.c, _i_bor);
)

CANDY_OPCODE(BORK,
  _bit_op(self, it, base, constants + it->iabc.c, _i_bor);
)

CANDY_OPCODE(BXOR,
  _bit_op(self, it, base, base + it->iabc.c, _i_bxor);
)

CANDY_OPCODE(BXORK,
  _bit_op(self, it, base, constants + it->iabc.c, _i_bxor);
)

CANDY_OPCODE(SHL,
  _bit_op(self, it, base, base + it->iabc.c, _i_shl);
)

CANDY_OPCODE(SHLK,
  _bit_op(self, it, base, constants + it->iabc.c, _i_shl);
)

CANDY_OPCODE(SHR,
  _bit_op(self, it, base, base + it->iabc.c, _i_shr);
)

CANDY_OPCODE(SHRK,
  _bit_op(self, it, base, constants + it->iabc.c, _i_shr);
)

CANDY_OPCODE(JMP,
  _op_jmp(self, it, &pc);
)

CANDY_OPCODE(JMPF,
  _op_jmpf(self, it, base, &pc);
)

CANDY_OPCODE(JMPT,
  _op_jmpt(self, it, base, &pc);
)

CANDY_OPCODE(MOVE,
  _op_move(self, it, base);
)

CANDY_OPCODE(CALL,
  if (_op_call(self, it, base, &pc))
    goto reload;
)

CANDY_OPCODE(RETURN,
  if (_op_return(self, it, base, &pc))
    goto reload;
  return;
)

CANDY_OPCODE(LOADK,
  _op_loadk(self, it, base, constants);
)

CANDY_OPCODE(LOADG,
  _op_loadg(self, it, base, constants, &globals);
)

CANDY_OPCODE(SETG,
  _op_setg(self, it, base, constants, &globals);
)

/* Bx selects an array (1) or table (0). */
CANDY_OPCODE(NEWCONTAINER,
  _op_newcontainer(self, it, base);
)

CANDY_OPCODE(GETTABLE,
  _op_gettable(self, it, base);
)

CANDY_OPCODE(SETTABLE,
  _op_settable(self, it, base);
)

CANDY_OPCODE(SETLIST,
  _op_setlist(self, it, base, constants);
)

CANDY_OPCODE(LEN,
  _op_len(self, it, base);
)

CANDY_OPCODE(FORLOOP,
  _op_forloop(self, it, base, &pc);
)

CANDY_OPCODE(TAILCALL,
  if (_op_tailcall(self, it, base, &pc))
    goto reload;
  return;
)

CANDY_OPCODE(CALLSELF,
  _op_callself(self, it, &pc);
  goto reload;
)

CANDY_OPCODE(TAILCALLSELF,
  _op_tailcallself(self, it, base, &pc);
  goto reload;
)

/* `global = global + operand`: one instruction for read-modify-write. */
CANDY_OPCODE(ADDG,
  _op_addg(self, it, constants, base, &globals);
)

CANDY_OPCODE(ADDGK,
  _op_addg(self, it, constants, constants, &globals);
)

CANDY_OPCODE(CLOSURE,
  _op_closure(self, it, base, constants);
)

CANDY_OPCODE(GETUPVAL,
  _op_getupval(self, it, base);
)

CANDY_OPCODE(SETUPVAL,
  _op_setupval(self, it, base);
)

CANDY_OPCODE(CALLMETHOD,
  size_t next_pc = pc;
  bool refresh = _op_callmethod(self, it, base, &next_pc);
  pc = next_pc;
  if (refresh)
    goto reload;
)

CANDY_OPCODE(LOADI,
  candy_wrap_set_integer(base + it->iabx.a, (candy_integer_t)it->iabx.b);
)

CANDY_OPCODE(TESTLT,
  vmtestorder(_less_than);
)

CANDY_OPCODE(ADDI,
  _add_integer(base + it->iabc.a, base + it->iabc.b, (candy_integer_t)it->iabc.c - CANDY_ADDI_BIAS);
)

CANDY_OPCODE(TESTLE,
  vmtestorder(_less_equal);
)

#endif /* CANDY_OPCODE */
