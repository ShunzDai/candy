#ifdef CANDY_OPCODE
#undef CANDY_OPCODE
#endif /* CANDY_OPCODE */

#if defined(CANDY_OPCODE_ENUM)
#undef CANDY_OPCODE_ENUM
#define CANDY_OPCODE(_opcode, ...) OP_##_opcode,
#endif /* CANDY_OPCODE_ENUM */

#if defined(CANDY_OPCODE_CASE)
#undef CANDY_OPCODE_CASE
#define CANDY_OPCODE(_opcode, ...) vmcase(_opcode): { \
  __VA_ARGS__ \
  vmbreak(); \
}
#endif /* CANDY_OPCODE_CASE */

#if defined(CANDY_OPCODE_LABEL)
#undef CANDY_OPCODE_LABEL
#define CANDY_OPCODE(_opcode, ...) &&L_##_opcode,
#endif /* CANDY_OPCODE_LABEL */

#ifdef CANDY_OPCODE_STR
#undef CANDY_OPCODE_STR
#define CANDY_OPCODE(_opcode, ...) #_opcode,
#endif /* CANDY_OPCODE_STR */

#ifdef CANDY_OPCODE
CANDY_OPCODE(LOADG,
  _op_loadg(self, it, cst);
)

CANDY_OPCODE(LOADC,
  _op_loadc(self, it, cst);
)

CANDY_OPCODE(SETG,
  _op_setg(self, it, cst);
)

CANDY_OPCODE(CALL,
  _op_call(self, it, co);
)
#endif /* CANDY_OPCODE */
