#ifdef CANDY_OP
#undef CANDY_OP
#endif /* CANDY_OP */

#ifdef CANDY_OP_ENUM
#undef CANDY_OP_ENUM
#define CANDY_OP(_name, ...) TK_##_name = gen_operator(__VA_ARGS__),
#endif /* CANDY_OP_ENUM */

#ifdef CANDY_OP_STR
#undef CANDY_OP_STR
#define CANDY_OP(_name, ...) case TK_##_name: return #_name;
#endif /* CANDY_OP_STR */

#ifdef CANDY_OP_TEST
#undef CANDY_OP_TEST
#define CANDY_OP(_name, ...) TEST_NORMAL(_name, TK_##_name, std::string{__VA_ARGS__}.data());
#endif /* CANDY_OP_TEST */

#ifdef CANDY_OP
CANDY_OP(PERCENT, '%')
CANDY_OP(  AMPER, '&')
CANDY_OP( LPAREN, '(')
CANDY_OP( RPAREN, ')')
CANDY_OP(   ASTE, '*')
CANDY_OP(   PLUS, '+')
CANDY_OP(  COMMA, ',')
CANDY_OP(  MINUS, '-')
CANDY_OP(    DOT, '.')
CANDY_OP(  SLASH, '/')
CANDY_OP(  COLON, ':')
CANDY_OP(   LESS, '<')
CANDY_OP( ASSIGN, '=')
CANDY_OP(GREATER, '>')
CANDY_OP(LSQUARE, '[')
CANDY_OP(RSQUARE, ']')
CANDY_OP(  CARET, '^')
CANDY_OP( LBRACE, '{')
CANDY_OP(   VERT, '|')
CANDY_OP( RBRACE, '}')
CANDY_OP(  TILDE, '~')
CANDY_OP(  EQUAL, '=', '=')
CANDY_OP( NEQUAL, '!', '=')
CANDY_OP( MODASS, '%', '=')
CANDY_OP( MULASS, '*', '=')
CANDY_OP( ADDASS, '+', '=')
CANDY_OP( AMPASS, '&', '=')
CANDY_OP( VERASS, '|', '=')
CANDY_OP( CARASS, '^', '=')
CANDY_OP( SUBASS, '-', '=')
CANDY_OP( DIVASS, '/', '=')
CANDY_OP( LSHIFT, '<', '<')
CANDY_OP( RSHIFT, '>', '>')
CANDY_OP( LEQUAL, '<', '=')
CANDY_OP( GEQUAL, '>', '=')
CANDY_OP( VARARG, '.', '.', '.')
#endif /* CANDY_OP */
