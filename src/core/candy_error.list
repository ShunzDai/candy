#ifdef CANDY_ERR
#undef CANDY_ERR
#endif /* CANDY_ERR */

#ifdef CANDY_ERR_ENUM
#undef CANDY_ERR_ENUM
#define CANDY_ERR(_err, _val, _str) CANDY_##_err = -_val,
#endif /* CANDY_ERR_ENUM */

#ifdef CANDY_ERR_STR
#undef CANDY_ERR_STR
#define CANDY_ERR(_err, _val, _str) case CANDY_##_err: return _str;
#endif /* CANDY_ERR_STR */

#ifdef CANDY_ERR
CANDY_ERR(OK         , 0x0000,      "ok")
CANDY_ERR(ERR        , 0x0001, "default")
CANDY_ERR(ERR_MEMORY , 0x1000,  "memory")
CANDY_ERR(ERR_ARRAY  , 0x1001,   "array")
CANDY_ERR(ERR_LEXICAL, 0x2000, "lexical")
CANDY_ERR(ERR_SYNTAX , 0x2001,  "syntax")
CANDY_ERR(ERR_VM     , 0x2002,      "vm")
CANDY_ERR(ERR_UNHASH , 0xF000, "runtime")
#endif /* CANDY_ERR */
